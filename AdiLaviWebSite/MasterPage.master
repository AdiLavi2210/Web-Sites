<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>עדי</title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        img.gallery{
            width: 150px; 
            height: 150px;
            margin: 10px 0; 
            display: block; 
        }
        .navigation-column {
            width: 180px; 
            vertical-align: top;
            padding: 10px;
            background-color: #f0f0f0; 
        }
        .content-column {
            width: auto; 
            vertical-align: top;
            padding: 10px;
        }
        .user-greeting {
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
            font-family: Arial, sans-serif;
        }
    </style>
</head>
<body dir="rtl" style="background-color: whitesmoke">
    <center>
        <table border="1" style ="width: 100%; border-collapse: collapse;">
            
            <tr style ="height:80px">
                <td style="text-align:center" colspan="2">
                    <font style ="color: black; font-size:60px; font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif">האתר לאוהבי הטיולים לחו"ל </font>
                </td>
            </tr>
            
            <tr>
                <td class="navigation-column">
                    <center>
                        <div class="user-greeting"> 
                        <%if (Session["nihol"] == "ok" || Session["user"] == "ok") { %>

                            שלום <%=Session["name"] %>
                         <%}%>
                        </div>

                        <a href="home.aspx"><img src="imges/home1.png" class="gallery" alt="דף בית"/></a>

                        <%if (Session["nihol"] != "ok" || Session["user"] != "ok") { %>
                            <a href="harshama.aspx"><img src="imges/harshama1.png" class="gallery" alt="הרשמה"/></a>
                            <a href="login.aspx"><img src="imges/login11.png" class="gallery" alt="כניסה"/></a>
                        <%}%>

                        <%if (Session["nihol"] == "ok" && Session["user"] == "ok") { %>
                            <a href="exit.aspx"><img src="imges/exit1.png" class="gallery" alt="יציאה"/></a>
                            <a href="aodot.aspx"><img src="imges/aodot1.png" class="gallery" alt="אודות"/></a>
                            <a href="galeria.aspx"><img src="imges/galeria1.png" class="gallery" alt="גלריה"/>
                            <a href="search.aspx"><img src="imges/search1.png" class="gallery" alt="חיפוש"/></a>
                            <a href="ShowItems.aspx"><img src="imges/items_icon.png" class="gallery" alt="הצגת פריטים"/></a>

                            </a>
                        <%}%>

                        <%if (Session["nihol"] == "ok") { %>
                        <a href="menahel.aspx"><img src="imges/menahel1.png" class="gallery" alt="מנהל"/></a>
                        <a href="update.aspx"><img src="imges/update1.png" class="gallery" alt="עדכון"/></a>
                        <a href="AddItem.aspx"><img src="imges/add_icon.png" class="gallery" alt="הוספת פריט"/></a>
                        <%}%>

                    </center>
                </td>
                
                <td class="content-column">
                    <center>
                         <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
                         </asp:ContentPlaceHolder>
                    </center>
                </td>
            </tr>
        </table>
    </center>
</body>
</html>
